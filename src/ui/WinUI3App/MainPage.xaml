<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WinUI3App.MainPage"
             Title="My Agent (PR 2 - MAUI Shell Skeleton)">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top navigation / command bar (adapted from WinUI CommandBar) -->
        <HorizontalStackLayout Grid.Row="0" BackgroundColor="#E0E0E0" Padding="8" Spacing="8">
            <Button Text="Chat" Clicked="NavChat_Click"/>
            <Button Text="Suggestions" Clicked="NavSuggestions_Click"/>
            <Button Text="Dashboard" Clicked="NavDashboard_Click"/>
            <Button Text="Settings" Clicked="NavSettings_Click"/>
            <Button Text="Test Transport" Clicked="TestTransport_Click" BackgroundColor="LightBlue"/>
        </HorizontalStackLayout>

        <!-- Main content area -->
        <Grid Grid.Row="1" Padding="16">
            <!-- Chat pane -->
            <VerticalStackLayout x:Name="ChatPane" IsVisible="True">
                <Label Text="Chat (stub)" FontSize="Large" Margin="0,0,0,8"/>
                <Entry x:Name="ChatInput" Placeholder="Type a message to the agent..." />
                <Button Text="Send (stub)" Clicked="SendChat_Click" Margin="0,8,0,0"/>
                <Label Text="Conversation (local only, no backend yet):" Margin="0,8,0,4"/>
                <Editor x:Name="ChatLog" IsReadOnly="True" HeightRequest="200" />
            </VerticalStackLayout>

            <!-- Suggestions pane -->
            <VerticalStackLayout x:Name="SuggestionsPane" IsVisible="False">
                <Label Text="Proactive Suggestions (stub)" FontSize="Large" Margin="0,0,0,8"/>
                <VerticalStackLayout x:Name="SuggestionsList" Spacing="4">
                    <Label Text="Review 12 new files in Downloads (high confidence)"/>
                    <Label Text="Calendar conflict tomorrow — suggest reschedule?"/>
                    <Label Text="Research results ready for &quot;Q3 budget model&quot;"/>
                </VerticalStackLayout>
                <Button Text="Refresh Suggestions (stub)" Margin="0,8,0,0"/>
            </VerticalStackLayout>

            <!-- Dashboard pane -->
            <VerticalStackLayout x:Name="DashboardPane" IsVisible="False">
                <Label Text="Task Dashboard (stub)" FontSize="Large" Margin="0,0,0,8"/>
                <Label Text="No active tasks. Agent core not connected (PR 3)." TextColor="Gray"/>
                <Label Text="History will appear here after PR 3." Margin="0,8,0,0"/>
            </VerticalStackLayout>

            <!-- Settings stub -->
            <VerticalStackLayout x:Name="SettingsPane" IsVisible="False">
                <Label Text="Settings (stub)" FontSize="Large" Margin="0,0,0,8"/>
                <CheckBox IsChecked="True"/>
                <Label Text="Enable proactive suggestions (Downloads watcher)"/>
                <CheckBox IsChecked="True"/>
                <Label Text="Prefer local models when possible"/>
                <Label Text="Transport: Named Pipe + JSON (per IPC spike recommendation in docs/ipc-spike.md)" FontSize="12" Margin="0,12,0,0"/>
                <Label Text="Model routing and full consents in PR 4+." TextColor="Gray" Margin="0,4,0,0"/>
            </VerticalStackLayout>

            <!-- Transport test result area -->
            <Border Grid.Row="1" VerticalOptions="End" BackgroundColor="#E0E0E0" Padding="12" Margin="0,12,0,0">
                <VerticalStackLayout>
                    <Label Text="Transport Status (PR 2 stub)" FontAttributes="Bold"/>
                    <Label x:Name="TransportStatus" Text="Not connected. Click 'Test Transport' above." />
                    <Label Text="NamedPipeClientStream → \\.\pipe\my-agent-ipc (dummy ping)" FontSize="11" TextColor="Gray"/>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <Label Grid.Row="2" Text="PR 2 skeleton - adapted to use installed .NET MAUI workload and WindowsAppRuntimes (no full WindowsAppSDK VS workload needed). No functional backend." 
               FontSize="11" TextColor="Gray" Padding="16,4" HorizontalTextAlignment="Center"/>
    </Grid>
</ContentPage>
